  {
    "id": "internal.tailhelpers.usage-summed-categories",
    "calls": [
      {
        "op": "tailhelpers.usage",
        "messages": [
          {
            "role": "system",
            "content": "Follow the project rules."
          },
          {
            "role": "user",
            "content": "Inspect the code."
          },
          {
            "role": "assistant",
            "content": "I will read the relevant files."
          },
          {
            "role": "tool",
            "content": "packages/gateway/src/tools/token-estimator.ts"
          }
        ],
        "schemas": [
          {
            "type": "function",
            "function": {
              "name": "read_file",
              "description": "Read a file",
              "parameters": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  }
                }
              }
            }
          }
        ],
        "limit": 10
      }
    ],
    "assertions": [
      {
        "path": "/0/system",
        "kind": "gt",
        "value": 0
      },
      {
        "path": "/0/history",
        "kind": "gt-path",
        "other": "/0/system",
        "factor": 1
      },
      {
        "path": "/0/toolResults",
        "kind": "gt",
        "value": 0
      },
      {
        "path": "/0/tools",
        "kind": "gt",
        "value": 0
      },
      {
        "path": "/0/total",
        "kind": "sum-paths-eq",
        "paths": [
          "/0/system",
          "/0/history",
          "/0/toolResults",
          "/0/tools"
        ]
      },
      {
        "path": "/0/limit",
        "kind": "eq",
        "value": 10
      },
      {
        "path": "/0/ratio",
        "kind": "eq",
        "value": 1
      }
    ]
  },
  {
    "id": "internal.tailhelpers.coerce-nested-array",
    "calls": [
      {
        "op": "tailhelpers.validate",
        "schema": {
          "type": "object",
          "properties": {
            "todoList": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "integer"
                  },
                  "title": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "not-started",
                      "in-progress",
                      "completed"
                    ]
                  }
                },
                "required": [
                  "id",
                  "title",
                  "status"
                ]
              }
            }
          },
          "required": [
            "todoList"
          ]
        },
        "input": {
          "todoList": [
            {
              "id": "1",
              "title": "Ship tests",
              "status": "in-progress"
            }
          ]
        }
      }
    ],
    "assertions": [
      {
        "path": "/0/result",
        "kind": "eq",
        "value": {
          "valid": true,
          "errors": []
        }
      },
      {
        "path": "/0/input",
        "kind": "eq",
        "value": {
          "todoList": [
            {
              "id": 1,
              "title": "Ship tests",
              "status": "in-progress"
            }
          ]
        }
      }
    ]
  },
  {
    "id": "internal.tailhelpers.nested-required-path",
    "calls": [
      {
        "op": "tailhelpers.validate",
        "schema": {
          "type": "object",
          "properties": {
            "threads": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "runtimeMode": {
                    "type": "string",
                    "enum": [
                      "full-access",
                      "supervised"
                    ]
                  }
                },
                "required": [
                  "title"
                ]
              }
            }
          }
        },
        "input": {
          "threads": [
            {
              "runtimeMode": "full-access"
            }
          ]
        }
      }
    ],
    "assertions": [
      {
        "path": "/0/result/valid",
        "kind": "eq",
        "value": false
      },
      {
        "path": "/0/result/errors",
        "kind": "array-contains",
        "value": "Missing required property: threads[0].title"
      }
    ]
  },
  {
