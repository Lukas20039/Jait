      {
        "path": "/2",
        "kind": "eq",
        "value": 0
      }
    ]
  },
  {
    "id": "internal.tailhelpers.message-tool-calls",
    "calls": [
      {
        "op": "tailhelpers.message",
        "message": {
          "role": "user",
          "content": "abcd"
        }
      },
      {
        "op": "tailhelpers.message",
        "message": {
          "role": "assistant",
          "content": "abcd",
          "tool_calls": [
            {
              "name": "read_file",
              "args": {
                "path": "README.md"
              }
            }
          ]
        }
      },
      {
        "op": "tailhelpers.message",
        "message": {
          "role": "assistant",
          "content": "abcd"
        }
      }
    ],
    "assertions": [
      {
        "path": "/0",
        "kind": "eq",
        "value": 6
      },
      {
        "path": "/1",
        "kind": "gt-path",
        "other": "/2",
        "factor": 1
      }
    ]
  },
  {
    "id": "internal.tailhelpers.hidden-thinking",
    "calls": [
      {
        "op": "tailhelpers.message",
        "message": {
          "role": "assistant",
          "content": "abcd"
        }
      },
      {
        "op": "tailhelpers.message",
        "message": {
          "role": "assistant",
          "content": "abcd",
          "thinking": "Let me analyze this step by step. The user wants me to read the file."
        }
      }
    ],
    "assertions": [
      {
        "path": "/1",
        "kind": "gt-path",
        "other": "/0",
        "factor": 1
      },
      {
        "path": "/1",
        "kind": "difference-ge",
        "value": 15,
        "other": "/0"
      }
    ]
  },
  {
