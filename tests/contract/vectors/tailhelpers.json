  {
    "id": "internal.tailhelpers.reject-nonfinite",
    "calls": [
      {
        "op": "tailhelpers.validate",
        "schema": {
          "type": "object",
          "properties": {
            "timeoutMs": {
              "type": "number"
            },
            "retryCount": {
              "type": "integer"
            }
          },
          "required": [
            "timeoutMs",
            "retryCount"
          ]
        },
        "input": {
          "timeoutMs": {
            "$fixture": "nan"
          },
          "retryCount": 1
        }
      },
      {
        "op": "tailhelpers.validate",
        "schema": {
          "type": "object",
          "properties": {
            "timeoutMs": {
              "type": "number"
            },
            "retryCount": {
              "type": "integer"
            }
          },
          "required": [
            "timeoutMs",
            "retryCount"
          ]
        },
        "input": {
          "timeoutMs": 1000,
          "retryCount": {
            "$fixture": "infinity"
          }
        }
      }
    ],
    "assertions": [
      {
        "path": "/0/result",
        "kind": "eq",
        "value": {
          "valid": false,
          "errors": [
