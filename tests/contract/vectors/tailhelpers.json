[
  {
    "id": "internal.tailhelpers.plain-and-json-rounding",
    "calls": [
      {
        "op": "tailhelpers.text",
        "value": ""
      },
      {
        "op": "tailhelpers.text",
        "value": "abcd"
      },
      {
        "op": "tailhelpers.json",
        "value": "abcd"
      },
