        "op": "tailhelpers.json",
        "value": {
          "a": "abcd"
        }
      }
    ],
    "assertions": [
      {
        "path": "/0",
        "kind": "eq",
        "value": 0
      },
      {
        "path": "/1",
        "kind": "eq",
        "value": 2
      },
      {
        "path": "/2",
        "kind": "eq",
        "value": 1
      },
      {
        "path": "/3",
        "kind": "eq",
        "value": 3
      }
    ]
  },
