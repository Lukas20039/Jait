[
  {
    "id": "internal.passwords.existing-scrypt-credentials",
    "calls": [
      {
        "op": "passwords.verify",
        "credentials": [
          {
            "username": " ALICE ",
            "password": "correct password 🦀"
          },
          {
            "username": "alice",
            "password": "wrong"
          },
          {
            "username": "missing",
            "password": "correct password 🦀"
          }
        ]
      }
    ],
    "assertions": [
      {
        "path": "/0/0/value/id",
        "kind": "eq",
        "value": "owner"
      },
      {
        "path": "/0/1/value",
        "kind": "eq",
        "value": null
      },
      {
        "path": "/0/2/value",
        "kind": "eq",
        "value": null
      }
    ]
  },
